# ===== ego signals — variáveis de ambiente =====
# Copie para .env (dev) ou configure no dashboard do Render (prod).

# --- Upstream Interhuman (obrigatório) ---
INTERHUMAN_API_KEY=ih_live_your_key_here

# --- Servidor ---
PORT=3737
ALLOWED_ORIGINS=https://ego.sougni.com

# --- Auth / sessão ---
# TOKEN_SECRET assina os tokens HMAC. OBRIGATÓRIO (senão o boot aborta).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=troque-por-32-bytes-hex-aleatorios
TOKEN_TTL_HOURS=24
# PASSCODE: fallback legado do WS (opcional). Só no servidor, nunca no cliente.
PASSCODE=opcional-segredo-legado
# USERS: fallback legado "email1:senha1,email2:senha2" (opcional; o banco é a fonte de verdade)
USERS=

# --- Banco de usuários/papéis (Turso / libSQL) ---
# Em dev, deixe em branco → usa arquivo local ./data/ego.db automaticamente.
# Em prod, cole a URL e o token do banco criado em turso.tech.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Seed do primeiro admin (aplicado só quando a tabela de usuários está vazia).
ADMIN_EMAIL=admin@sougni.com
ADMIN_PASSWORD=troque-esta-senha

# --- Perfilamento Claude (opcional; sem a chave cai no fallback rule-based) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
